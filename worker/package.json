{
  "name": "lastmile-delivery-api",
  "version": "1.0.0",
  "description": "Last-Mile Delivery Tracker API — Hono.js on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute lastmile_db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute lastmile_db --remote --file=schema.sql",
    "db:seed:local": "wrangler d1 execute lastmile_db --local --file=seed.sql"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
